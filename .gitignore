# 本地 exe 启动器（由 firefly-launcher/build.ps1 生成），不进仓库
*.exe

# 构建产物：带内容哈希的静态资源副本（由 build.mjs 在构建时生成）
# 例如 main.a1b2c3d4.js / styles.0f9e8d7c.css，不进仓库
/[a-zA-Z0-9_-]*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].js
/[a-zA-Z0-9_-]*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].css

# npm 依赖（Edge Functions 用的 @edgeone/pages-blob），构建时再装
node_modules/

# 投稿管理令牌：只存本地，绝不进仓库
submissions-token.txt

# 拉取下来的投稿表格（含投稿人昵称，属于个人数据）
投稿汇总.xlsx

# 考核成绩表（含 QQ 号，属于个人信息）
考核成绩.xlsx

# Python 缓存（跑 build_font.py 时会生成）
__pycache__/
